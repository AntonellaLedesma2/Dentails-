EXPO_PUBLIC_API_URL_WEB=http://localhost:3000/api
# Para un teléfono físico, usar la IP local de la computadora (misma red Wi-Fi).
# Ejemplo: http://192.168.1.20:3000/api
EXPO_PUBLIC_API_URL_NATIVE=http://TU_IP_LOCAL:3000/api
# Google web client (tipo Aplicación web); usar el mismo ID público en el backend.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=tu_google_web_client_id.apps.googleusercontent.com
# GitHub OAuth App y Facebook App (IDs públicos).
EXPO_PUBLIC_GITHUB_CLIENT_ID=tu_github_client_id
EXPO_PUBLIC_FACEBOOK_APP_ID=tu_facebook_app_id
