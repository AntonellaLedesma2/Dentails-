{
  "expo": {
    "name": "DENTALIS",
    "slug": "dentalis",
    "version": "1.0.0",
    "sdkVersion": "58.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "com.dentalis.app",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dentalis.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "DENTALIS se conecta a la API de la clínica en la red local durante las pruebas.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "192.168.100.34": {
              "NSIncludesSubdomains": false,
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      }
    },
    "android": {
      "package": "com.dentalis.app",
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#2563eb"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-asset",
      "expo-status-bar",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.721085208228-34q0kchuv5om9b5sscrb1i9g7ficfs8o"
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "2226433624961976",
          "displayName": "DENTALIS",
          "scheme": "fb2226433624961976"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4ed943c3-d588-4ca1-9904-d2f8cf8748f9"
      }
    }
  }
}
