PORT=3000
NODE_ENV=development
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=dentalis
DB_PORT=3306
DB_SSL=false
# For TiDB Cloud on Render, upload the downloaded CA certificate as a Secret File
# and set DB_SSL_CA to its mounted path (for example /etc/secrets/tidb-ca.pem).
DB_SSL_CA=
JWT_SECRET=cambiar_por_una_clave_larga
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=cambiar_por_otra_clave_larga
JWT_REFRESH_EXPIRES_IN=7d
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
GOOGLE_WEB_CLIENT_ID=tu_google_web_client_id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=secreto_solo_del_backend
GOOGLE_ANDROID_CLIENT_ID=tu_google_android_client_id.apps.googleusercontent.com
# Cliente nativo público: nunca agregar su secreto al frontend/APK.
GOOGLE_ANDROID_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=tu_google_ios_client_id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_SECRET=
GITHUB_CLIENT_ID=tu_github_client_id
GITHUB_CLIENT_SECRET=
GITHUB_WEB_CLIENT_ID=tu_github_client_id
GITHUB_WEB_CLIENT_SECRET=
GITHUB_NATIVE_CLIENT_ID=
GITHUB_NATIVE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
OAUTH_REDIRECT_URI=com.dentalis.app://oauth
# En desarrollo localhost se permite automáticamente. En producción agrega el callback HTTPS exacto.
OAUTH_REDIRECT_URIS=http://localhost:8081/,http://localhost:8081,com.dentalis.app://oauth
